<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zaidify Collections | Premium Ethnic Wear</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        /* ═══════════════════════════════════════════
           BASE / STORE STYLES
        ═══════════════════════════════════════════ */
        :root {
            --pink: #ff00ff; --bg: #08020f; --nav-bg: #000;
            --gold: #ffd700; --white: #ffffff;
            --card: rgba(255,255,255,0.03); --border: rgba(255,255,255,0.1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        body { background: var(--bg); color: var(--white); font-family: 'Poppins', sans-serif; overflow-x: hidden; -webkit-font-smoothing: antialiased; }

        /* ── NAV ── */
        nav { width: 100%; padding: 12px 6%; display: flex; justify-content: space-between; align-items: center; background: var(--nav-bg); position: fixed; top: 0; z-index: 9999; border-bottom: 1px solid var(--border); }
        .logo-box { display: flex; align-items: center; gap: 10px; text-decoration: none; color: white; font-family: 'Bebas Neue'; font-size: 1.4rem; }
        .logo-img { height: 30px; }
        .nav-links { display: flex; gap: 20px; align-items: center; }
        .nav-links a { color: white; text-decoration: none; font-family: 'Bebas Neue'; font-size: 1rem; }
        .shop-now-btn { background: var(--pink); padding: 8px 16px; border-radius: 5px; font-weight: 800; color: white !important; }
        .nav-user-btn { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: white; padding: 6px 16px; border-radius: 5px; cursor: pointer; font-family: 'Bebas Neue'; font-size: 1rem; letter-spacing: 1px; transition: 0.2s; }
        .nav-user-btn:hover { background: var(--pink); border-color: var(--pink); }
        .nav-admin-btn { background: rgba(255,0,255,0.15); border: 1px solid var(--pink); color: var(--pink); padding: 6px 16px; border-radius: 5px; cursor: pointer; font-family: 'Bebas Neue'; font-size: 1rem; letter-spacing: 1px; margin-left: 6px; transition: 0.2s; }
        .nav-admin-btn:hover { background: var(--pink); color: white; }

        /* ── HERO ── */
        .hero { height: 40vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; margin-top: 60px; background: radial-gradient(circle at center, #1a052e 0%, #08020f 100%); }
        .hero-logo { width: 100px; margin-bottom: 15px; filter: drop-shadow(0 0 15px var(--pink)); }
        .hero h1 { font-family: 'Bebas Neue'; font-size: clamp(3rem, 12vw, 6rem); letter-spacing: 8px; }

        /* ── STORE SECTIONS ── */
        section { padding: 60px 6%; width: 100%; max-width: 1200px; margin: 0 auto; }
        .section-title { text-align: center; font-family: 'Bebas Neue'; font-size: clamp(2.5rem, 8vw, 3.5rem); margin-bottom: 30px; color: var(--pink); letter-spacing: 2px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; margin-bottom: 40px; }
        .card { background: rgba(255,255,255,0.03); padding: 50px 20px; border-radius: 20px; text-align: center; border: 1px solid rgba(255,255,255,0.1); text-decoration: none; color: white; transition: 0.3s; }
        .card h3 { font-family: 'Bebas Neue'; font-size: 2.2rem; }
        .card.inactive { opacity: 0.3; cursor: not-allowed; }

        /* ── PRODUCT CARDS ── */
        .p-wrapper { display: flex; flex-wrap: wrap; background: rgba(255,255,255,0.02); border-radius: 20px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 60px; box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
        .p-img-box { flex: 1; min-width: 350px; position: relative; height: 550px; }
        .p-content { flex: 1.2; padding: 40px; min-width: 350px; display: flex; flex-direction: column; justify-content: center; }
        .slider-container { position: relative; width: 100%; height: 100%; overflow: hidden; background: #000; }
        .slides { display: flex; transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1); height: 100%; }
        .slides img { width: 100%; flex-shrink: 0; object-fit: cover; }
        .slider-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.7); color: white; border: none; width: 50px; height: 50px; border-radius: 50%; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
        .prev { left: 15px; } .next { right: 15px; }
        .rating-box { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
        .stars { color: var(--gold); }
        .rev-count { color: rgba(255,255,255,0.4); font-size: 0.85rem; }
        .product-name { font-size: 2.2rem; margin: 5px 0; font-weight: 700; }
        .admin-ref { display: none; }
        .label { font-size: 0.9rem; font-weight: 700; margin-top: 15px; color: var(--pink); text-transform: uppercase; letter-spacing: 1px; }
        .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0 15px 0; }
        .box { border: 1px solid rgba(255,255,255,0.2); padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 0.75rem; text-align: center; min-width: 45px; transition: 0.2s; }
        .box:hover { border-color: var(--pink); }
        .box.active { background: var(--pink); border-color: var(--pink); color: white; transform: scale(1.05); }
        .price-now { font-size: 2.8rem; font-weight: 900; }
        .price-old { text-decoration: line-through; opacity: 0.3; font-size: 1.3rem; margin-left: 12px; }
        .wa-btn { display: block; background: #25d366; color: white; text-align: center; padding: 20px; border-radius: 15px; text-decoration: none; font-weight: 900; font-size: 1.2rem; margin-top: 20px; transition: 0.3s; }
        .wa-btn:hover { background: #1ebe5d; transform: translateY(-2px); }
        .policy-btn { background: none; border: 1px solid rgba(255,255,255,0.2); color: white; padding: 12px 25px; border-radius: 5px; cursor: pointer; font-family: 'Bebas Neue'; letter-spacing: 2px; margin: 40px auto; display: block; transition: 0.2s; }
        .policy-btn:hover { border-color: var(--pink); color: var(--pink); }
        .loading-products { text-align: center; padding: 60px 0; color: rgba(255,255,255,0.4); font-family: 'Bebas Neue'; font-size: 1.5rem; letter-spacing: 2px; }
        .loading-products::after { content: ''; display: inline-block; animation: dots 1.2s infinite; }
        @keyframes dots { 0%{content:'.'} 33%{content:'..'} 66%{content:'...'} }

        /* ═══════════════════════════════════════════
           OVERLAY SYSTEM
        ═══════════════════════════════════════════ */
        .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.95); z-index: 10000; display: none; justify-content: center; align-items: flex-start; padding: 20px; overflow-y: auto; }
        .overlay.open { display: flex; }
        .overlay-center { align-items: center; }

        /* ═══════════════════════════════════════════
           POLICY MODAL
        ═══════════════════════════════════════════ */
        .policy-modal { background: #08020f; border: 1px solid var(--pink); padding: 30px; border-radius: 20px; max-width: 500px; width: 100%; position: relative; box-shadow: 0 0 30px var(--pink); color: white; margin: auto; }
        .close-modal { position: absolute; top: 15px; right: 20px; font-size: 2rem; cursor: pointer; color: var(--pink); font-weight: bold; line-height: 1; }
        .close-modal:hover { opacity: 0.7; }

        /* ═══════════════════════════════════════════
           LOGIN MODAL
        ═══════════════════════════════════════════ */
        .login-box { background: #0d0416; border: 1px solid rgba(255,0,255,0.4); border-radius: 24px; padding: 40px 36px; width: 100%; max-width: 420px; box-shadow: 0 0 60px rgba(255,0,255,0.15); position: relative; margin: auto; }
        .login-close { position: absolute; top: 16px; right: 20px; font-size: 1.8rem; cursor: pointer; color: var(--pink); font-weight: bold; line-height: 1; }
        .login-logo { text-align: center; margin-bottom: 24px; }
        .login-logo img { height: 44px; filter: drop-shadow(0 0 10px var(--pink)); margin-bottom: 6px; display: block; margin-inline: auto; }
        .login-logo h2 { font-family: 'Bebas Neue'; font-size: 1.5rem; letter-spacing: 5px; }
        .login-logo p { font-size: 0.72rem; color: rgba(255,255,255,0.35); letter-spacing: 2px; text-transform: uppercase; }
        .tab-row { display: flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 22px; }
        .tab { flex: 1; padding: 10px; text-align: center; cursor: pointer; font-family: 'Bebas Neue'; letter-spacing: 2px; font-size: 1rem; color: rgba(255,255,255,0.4); transition: 0.2s; }
        .tab.active { background: var(--pink); color: #fff; }
        .lfield { margin-bottom: 14px; }
        .lfield label { display: block; font-size: 0.72rem; color: rgba(255,255,255,0.45); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px; }
        .lfield input { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 10px; padding: 13px 15px; color: #fff; font-size: 0.9rem; font-family: 'Poppins'; outline: none; transition: 0.2s; }
        .lfield input:focus { border-color: var(--pink); box-shadow: 0 0 0 2px rgba(255,0,255,0.1); }
        .forgot-link { text-align: right; margin-bottom: 15px; }
        .forgot-link a { color: var(--pink); font-size: 0.75rem; text-decoration: none; font-weight: 600; cursor: pointer; }
        .forgot-link a:hover { text-decoration: underline; }
        .btn-main { width: 100%; background: var(--pink); color: #fff; border: none; border-radius: 12px; padding: 15px; font-family: 'Bebas Neue'; font-size: 1.2rem; letter-spacing: 3px; cursor: pointer; margin-top: 6px; transition: 0.2s; }
        .btn-main:hover { opacity: 0.85; }
        .divider { display: flex; align-items: center; gap: 12px; margin: 18px 0; color: rgba(255,255,255,0.2); font-size: 0.8rem; }
        .divider::before,.divider::after { content:''; flex:1; height:1px; background: rgba(255,255,255,0.1); }
        .btn-google { width: 100%; background: #fff; color: #1a1a1a; border: none; border-radius: 12px; padding: 13px; font-family: 'Poppins'; font-weight: 700; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: 0.2s; }
        .btn-google:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-google svg { width: 18px; height: 18px; }
        .lmsg { text-align: center; font-size: 0.82rem; margin-top: 14px; padding: 10px; border-radius: 8px; display: none; }
        .lmsg.ok { background: rgba(37,211,102,0.15); color: #25d366; display: block; }
        .lmsg.err { background: rgba(255,0,0,0.1); color: #ff6b6b; display: block; }

        /* ═══════════════════════════════════════════
           ADMIN PANEL
        ═══════════════════════════════════════════ */
        .admin-panel { background: #08020f; width: 100%; min-height: 100vh; display: flex; flex-direction: column; margin: auto; max-width: 100%; border-radius: 0; }
        .admin-topbar { background: #000; border-bottom: 1px solid rgba(255,0,255,0.3); padding: 14px 28px; display: flex; align-items: center; justify-content: space-between; }
        .admin-topbar-title { font-family: 'Bebas Neue'; font-size: 1.5rem; letter-spacing: 4px; color: var(--pink); }
        .admin-topbar-right { display: flex; align-items: center; gap: 12px; }
        .admin-topbar-right span { font-size: 0.75rem; color: rgba(255,255,255,0.35); }
        .abtn { background: rgba(255,255,255,0.07); border: 1px solid var(--border); color: #fff; padding: 7px 14px; border-radius: 8px; cursor: pointer; font-family: 'Bebas Neue'; letter-spacing: 1px; font-size: 0.9rem; transition: 0.2s; }
        .abtn:hover { border-color: var(--pink); color: var(--pink); }
        .admin-layout { display: flex; flex: 1; min-height: calc(100vh - 57px); }
        .admin-sidebar { width: 210px; background: rgba(255,255,255,0.02); border-right: 1px solid var(--border); padding: 20px 0; flex-shrink: 0; }
        .aside-item { padding: 13px 22px; cursor: pointer; font-family: 'Bebas Neue'; letter-spacing: 2px; font-size: 0.95rem; color: rgba(255,255,255,0.4); transition: 0.2s; display: flex; align-items: center; gap: 10px; border-left: 3px solid transparent; }
        .aside-item:hover { color: #fff; background: rgba(255,255,255,0.03); }
        .aside-item.active { color: var(--pink); border-left-color: var(--pink); background: rgba(255,0,255,0.05); }
        .admin-content { flex: 1; padding: 28px; overflow-y: auto; }
        .apage { display: none; }
        .apage.active { display: block; }

        .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 18px; margin-bottom: 28px; }
        .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; text-align: center; }
        .stat-card .num { font-family: 'Bebas Neue'; font-size: 2.6rem; color: var(--pink); }
        .stat-card .lbl { font-size: 0.72rem; color: rgba(255,255,255,0.35); letter-spacing: 1px; text-transform: uppercase; margin-top: 4px; }

        .sec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
        .sec-head h2 { font-family: 'Bebas Neue'; font-size: 1.7rem; letter-spacing: 3px; color: var(--pink); }
        .tbl-wrap { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
        table { width: 100%; border-collapse: collapse; }
        th { background: rgba(255,0,255,0.08); color: var(--pink); font-family: 'Bebas Neue'; letter-spacing: 2px; font-size: 0.82rem; padding: 13px 15px; text-align: left; border-bottom: 1px solid var(--border); }
        td { padding: 13px 15px; font-size: 0.8rem; border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,0.02); }
        .prod-thumb { width: 46px; height: 46px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); }
        .pid-badge { background: rgba(255,0,255,0.15); color: var(--pink); padding: 3px 8px; border-radius: 5px; font-size: 0.72rem; font-family: 'Bebas Neue'; letter-spacing: 1px; }
        .btn-edit { background: none; border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 5px 11px; border-radius: 6px; cursor: pointer; font-size: 0.72rem; transition: 0.2s; }
        .btn-edit:hover { border-color: var(--pink); color: var(--pink); }
        .btn-del { background: none; border: 1px solid rgba(255,0,0,0.3); color: rgba(255,80,80,0.8); padding: 5px 11px; border-radius: 6px; cursor: pointer; font-size: 0.72rem; margin-left: 5px; transition: 0.2s; }
        .btn-del:hover { background: rgba(255,0,0,0.1); }

        .edit-modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 20000; display: none; justify-content: center; align-items: flex-start; padding: 20px; overflow-y: auto; }
        .edit-modal-bg.open { display: flex; }
        .edit-modal { background: #0d0416; border: 1px solid var(--pink); border-radius: 20px; padding: 34px; width: 100%; max-width: 660px; box-shadow: 0 0 50px rgba(255,0,255,0.2); position: relative; margin: auto; }
        .edit-modal-title { font-family: 'Bebas Neue'; font-size: 1.7rem; color: var(--pink); letter-spacing: 3px; margin-bottom: 22px; }
        .edit-close { position: absolute; top: 16px; right: 18px; font-size: 1.8rem; cursor: pointer; color: var(--pink); font-weight: bold; line-height: 1; }
        .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .ffield { display: flex; flex-direction: column; gap: 5px; }
        .ffield.full { grid-column: 1 / -1; }
        .ffield label { font-size: 0.7rem; color: rgba(255,255,255,0.4); letter-spacing: 1px; text-transform: uppercase; }
        .ffield input, .ffield textarea { background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 9px; padding: 10px 13px; color: #fff; font-size: 0.85rem; font-family: 'Poppins'; outline: none; transition: 0.2s; width: 100%; }
        .ffield input:focus, .ffield textarea:focus { border-color: var(--pink); }
        .save-btn { width: 100%; background: var(--pink); color: #fff; border: none; border-radius: 11px; padding: 15px; font-family: 'Bebas Neue'; font-size: 1.15rem; letter-spacing: 3px; cursor: pointer; margin-top: 18px; transition: 0.2s; }
        .save-btn:hover { opacity: 0.85; }
        .img-preview { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        .img-preview img { width: 56px; height: 56px; object-fit: cover; border-radius: 7px; border: 1px solid var(--border); }

        .toast { position: fixed; bottom: 28px; right: 28px; background: #25d366; color: #fff; padding: 13px 22px; border-radius: 11px; font-family: 'Bebas Neue'; letter-spacing: 2px; font-size: 1rem; z-index: 99999; opacity: 0; pointer-events: none; transition: opacity 0.3s; box-shadow: 0 8px 30px rgba(0,0,0,0.4); }
        .toast.show { opacity: 1; pointer-events: auto; }
        .toast.err { background: #e53935; }

        @media (max-width: 768px) {
            .p-wrapper { flex-direction: column; }
            .p-img-box { height: 400px; min-width: unset; }
            .p-content { padding: 30px 20px; text-align: center; min-width: unset; }
            .row { justify-content: center; }
            .nav-links a:not(.shop-now-btn):not(.nav-user-btn):not(.nav-admin-btn) { display: none; }
            .admin-sidebar { width: 160px; }
            .fgrid { grid-template-columns: 1fr; }
            .ffield.full { grid-column: 1; }
        }
    </style>
</head>
<body>

<div id="store-page">
    <nav>
        <a href="#" class="logo-box"><img src="logo.png" class="logo-img" onerror="this.style.display='none'"><span>ZAIDIFY</span></a>
        <div class="nav-links">
            <a href="#categories">ABOUT</a>
            <a href="#women">WOMEN</a>
            <a href="#women" class="shop-now-btn">SHOP NOW</a>
            <button class="nav-user-btn" id="navLoginBtn" onclick="openLogin()">LOGIN</button>
            <button class="nav-admin-btn" id="navAdminBtn" onclick="openAdmin()" style="display:none;">⚡ ADMIN</button>
        </div>
    </nav>

    <header class="hero">
        <img src="logo.png" class="hero-logo" onerror="this.style.display='none'">
        <h1>ZAIDIFY</h1>
        <p>PREMIUM ETHNIC COLLECTIONS</p>
    </header>

    <section id="categories">
        <h2 class="section-title">OUR CATEGORIES</h2>
        <div class="grid">
            <a href="#women" class="card"><h3>WOMEN</h3><p>Kurtas & premium sets</p></a>
            <div class="card inactive"><h3>MEN</h3><p>Coming Soon</p></div>
            <div class="card inactive"><h3>KIDS</h3><p>Coming Soon</p></div>
        </div>
    </section>

    <section id="women">
        <h2 class="section-title">WOMEN'S ARRIVALS</h2>
        <div id="products-container">
            <div class="loading-products">Loading Products</div>
        </div>
        <button class="policy-btn" onclick="openPolicy()">Return & Exchange Policy</button>
    </section>
</div>

<!-- POLICY MODAL -->
<div class="overlay overlay-center" id="policyOverlay" onclick="closePolicyOutside(event)">
    <div class="policy-modal">
        <span class="close-modal" onclick="closePolicy()">×</span>
        <h2 style="font-family:'Bebas Neue';color:var(--pink);margin-bottom:15px;font-size:2rem;">Return & Exchange Policy</h2>
        <div style="font-size:0.85rem;line-height:1.8;opacity:0.9;">
            <p><b>7-Day Easy Returns:</b> Initiate returns within 7 days of delivery.</p><br>
            <p><b>Unboxing Video Required:</b> Continuous video of package opening is mandatory for verification.</p><br>
            <p><b>📲 To Request:</b> Send video and defect photos via WhatsApp.</p>
        </div>
    </div>
</div>

<!-- LOGIN MODAL -->
<div class="overlay overlay-center" id="loginOverlay" onclick="closeLoginOutside(event)">
    <div class="login-box">
        <span class="login-close" onclick="closeLogin()">×</span>
        <div class="login-logo">
            <img src="logo.png" onerror="this.style.display='none'">
            <h2>ZAIDIFY</h2>
            <p>Premium Ethnic Collections</p>
        </div>
        <div class="tab-row">
            <div class="tab active" id="tab-login" onclick="switchLoginTab('login')">LOGIN</div>
            <div class="tab" id="tab-signup" onclick="switchLoginTab('signup')">SIGN UP</div>
        </div>

        <div id="login-form-wrap">
            <div class="lfield"><label>Email</label><input type="email" id="li-email" placeholder="you@email.com"></div>
            <div class="lfield"><label>Password</label><input type="password" id="li-pass" placeholder="••••••••"></div>
            <div class="forgot-link">
                <a onclick="doForgotPassword()">Forgot Password?</a>
            </div>
            <button class="btn-main" onclick="doLogin()">LOGIN</button>
        </div>

        <div id="signup-form-wrap" style="display:none;">
            <div class="lfield"><label>Email</label><input type="email" id="su-email" placeholder="you@email.com"></div>
            <div class="lfield"><label>Password</label><input type="password" id="su-pass" placeholder="Min 6 characters"></div>
            <button class="btn-main" onclick="doSignup()">CREATE ACCOUNT</button>
        </div>

        <div class="divider">OR</div>
        <button class="btn-google" onclick="doGoogle()">
            <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.79-.07-1.54-.19-2.27h-11.3v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/><path fill="#34A853" d="M12.255 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96h-3.98v3.09C3.515 21.3 7.615 24 12.255 24z"/><path fill="#FBBC05" d="M5.525 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62h-3.98a11.86 11.86 0 000 10.76l3.98-3.09z"/><path fill="#EA4335" d="M12.255 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C18.205 1.19 15.495 0 12.255 0c-4.64 0-8.74 2.7-10.71 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z"/></svg>
