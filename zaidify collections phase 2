        refreshNavAuth();
    });
}

function refreshNavAuth() {
    const loginBtn = document.getElementById('navLoginBtn');
    const adminBtn = document.getElementById('navAdminBtn');
    if (currentUser) {
        loginBtn.textContent = 'LOGOUT';
        loginBtn.onclick = doLogout;
