// ══════════════════════════════════════════════
// STORE — PRODUCTS
// ══════════════════════════════════════════════
function parseSizes(raw)  { return (raw||'').replace(/[{}"'\[\]]/g,'').split(',').map(s=>s.trim()).filter(Boolean); }
function parseColors(raw) { return (raw||'').replace(/[{}"'\[\]]/g,'').split(',').map(c=>c.trim()).filter(Boolean); }

function getImages(p) {
    const imgs = [];
    for (let i=1;i<=10;i++) { const u=p[`image_${i}`]; if(u&&u!=='NULL'&&u.trim()) imgs.push(u.trim()); }
    return imgs;
}

function getPriceForSize(p, size) {
    const s = size.toUpperCase();
    if (s==='XXS') return p.price_xxs || p.price_standard || 0;
    if (s==='XS')  return p.price_xs  || p.price_standard || 0;
    return p.price_standard || 0;
}

function buildProduct(p) {
    const pid    = p.product_id.toUpperCase();
    const pidLow = pid.toLowerCase();
    const images = getImages(p);
    const sizes  = parseSizes(p.sizes);
    const colors = parseColors(p.colors);

    selections[pid]              = { size:'', price:'', color: colors[0]||'' };
    sliderPos[`slider-${pidLow}`] = 0;

    const slideImgs = images.length
        ? images.map(u=>`<img src="${u}" loading="lazy">`).join('')
        : `<div style="display:flex;align-items:center;justify-content:center;height:100%;color:rgba(255,255,255,0.15);font-family:'Bebas Neue';font-size:1.4rem;">NO IMAGE</div>`;

    let colorHTML = '';
    if (colors.length > 1) {
        colorHTML = `<p class="label">Colors:</p><div class="row">${
            colors.map((c,i)=>`<div class="box${i===0?' active':''}" onclick="selectOption(this,'${pid}','color','${c}')">${c}</div>`).join('')
        }</div>`;
    } else if (colors.length===1) {
        colorHTML = `<p class="label">Color: <span style="color:white;font-weight:400;">${colors[0]}</span></p>`;
    }

    const sizeBoxes = sizes.map(sz=>{
        const pr = getPriceForSize(p,sz);
        return `<div class="box" onclick="selectPrice(this,'${pid}','${sz}',${pr})">${sz}</div>`;
    }).join('');

    const mrp = p.price_standard ? `<span class="price-old">₹${Math.round(p.price_standard*1.8)}</span>` : '';

    return `
    <div class="p-wrapper" id="${pidLow}">
        <div class="p-img-box">
            <div class="slider-container" id="slider-${pidLow}">
                <div class="slides">${slideImgs}</div>
                <button class="slider-btn prev" onclick="moveSlide('slider-${pidLow}',-1)">&#10094;</button>
                <button class="slider-btn next" onclick="moveSlide('slider-${pidLow}',1)">&#10095;</button>
            </div>
        </div>
        <div class="p-content">
            <div class="rating-box"><div class="stars">★★★★★</div><div class="rev-count">4.1 (Reviews)</div></div>
            <h2 class="product-name">${p.name}</h2>
            <div class="admin-ref">${pid}</div>
            ${colorHTML}
            <p class="label">Sizes:</p>
            <div class="row">${sizeBoxes}</div>
            <div><span class="price-now" id="price-${pidLow}">₹---</span>${mrp}</div>
            <a href="#" onclick="order(event,'${pid}','${p.name}')" class="wa-btn">🛒 ORDER ON WHATSAPP</a>
        </div>
    </div>`;
}

async function loadProducts() {
    const container = document.getElementById('products-container');
    let { data, error } = await sb.from('products').select('*').order('id',{ascending:true});
    if (error || !data) {
        container.innerHTML = '<div class="loading-products" style="animation:none;">Could not load products</div>';
        return;
    }
    allProducts = data;
    if (!data.length) {
        container.innerHTML = '<div class="loading-products" style="animation:none;">No products yet</div>';
        return;
    }
    container.innerHTML = data.map(buildProduct).join('');
}

function moveSlide(id, step) {
    const slides = document.getElementById(id)?.querySelector('.slides');
    if (!slides) return;
    const total = slides.querySelectorAll('img').length;
    if (!total) return;
    sliderPos[id] = ((sliderPos[id]||0) + step + total) % total;
    slides.style.transform = `translateX(-${sliderPos[id]*100}%)`;
}

function selectOption(el, id, type, value) {
    el.parentElement.querySelectorAll('.box').forEach(b=>b.classList.remove('active'));
    el.classList.add('active');
    if (!selections[id]) selections[id]={size:'',price:'',color:''};
    selections[id][type] = value;
}

function selectPrice(el, id, size, price) {
    el.parentElement.querySelectorAll('.box').forEach(b=>b.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('price-'+id.toLowerCase()).innerText = '₹'+price;
    if (!selections[id]) selections[id]={size:'',price:'',color:''};
    selections[id].size  = size;
    selections[id].price = price;
}

function order(e, id, name) {
    e.preventDefault();
    const d = selections[id]||{};
    if (!d.size||!d.price) { alert('Please select a Size first!'); return; }
    const msg = `Hi Zaidify! I want to order:\n\n*Product:* ${name} (${id})\n*Color:* ${d.color}\n*Size:* ${d.size}\n*Price:* ₹${d.price}`;
    window.open(`https://wa.me/918655171445?text=${encodeURIComponent(msg)}`,'_blank');
}

