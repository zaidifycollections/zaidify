    document.getElementById(`apage-${name}`).classList.add('active');
    const map = {dashboard:0,products:1,add:2};
    document.querySelectorAll('.aside-item')[map[name]]?.classList.add('active');
}

async function loadAdminData() {
    const { data } = await sb.from('products').select('*').order('id',{ascending:true});
    allProducts = data||[];
    renderDashboard();
    renderProductsTable();
}

function renderDashboard() {
    document.getElementById('stat-total').textContent = allProducts.length;
    const cats = new Set(allProducts.map(p=>(p.category||'').toLowerCase()));
    document.getElementById('stat-cats').textContent = cats.size;
    const avgImgs = allProducts.length
        ? Math.round(allProducts.reduce((s,p)=>s+getImages(p).length,0)/allProducts.length)
        : 0;
    document.getElementById('stat-imgs').textContent = avgImgs;

    document.getElementById('dash-tbody').innerHTML = allProducts.map(p=>{
        const imgs = getImages(p);
        const thumb = imgs[0]
            ? `<img class="prod-thumb" src="${imgs[0]}" onerror="this.style.display='none'">`
            : `<div style="width:46px;height:46px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;font-size:0.55rem;color:rgba(255,255,255,0.2);">NO IMG</div>`;
        return `<tr>
            <td>${thumb}</td>
            <td><span class="pid-badge">${p.product_id}</span></td>
            <td style="font-weight:600;">${p.name}</td>
            <td>₹${p.price_standard||0}</td>
            <td style="font-size:0.72rem;color:rgba(255,255,255,0.4);">${(p.sizes||'').replace(/[{}"]/g,'').substring(0,45)}</td>
        </tr>`;
    }).join('');
}

function renderProductsTable() {
    document.getElementById('prod-tbody').innerHTML = allProducts.map(p=>{
        const imgs = getImages(p);
        const thumb = imgs[0]
            ? `<img class="prod-thumb" src="${imgs[0]}" onerror="this.style.display='none'">`
            : `<div style="width:46px;height:46px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;font-size:0.55rem;color:rgba(255,255,255,0.2);">NO IMG</div>`;
        return `<tr>
            <td>${thumb}</td>
            <td><span class="pid-badge">${p.product_id}</span></td>
            <td style="font-weight:600;">${p.name}</td>
            <td style="color:rgba(255,255,255,0.45);">${p.category}</td>
            <td>₹${p.price_xxs||0}</td>
            <td>₹${p.price_xs||0}</td>
            <td>₹${p.price_standard||0}</td>
            <td>
                <button class="btn-edit" onclick="openEdit(${p.id})">EDIT</button>
                <button class="btn-del" onclick="deleteProduct(${p.id},'${p.name.replace(/'/g,"\\'")}')">DEL</button>
            </td>
        </tr>`;
    }).join('');
}

function openEdit(id) {
    const p = allProducts.find(x=>x.id===id);
    if (!p) return;
    document.getElementById('e-dbid').value = p.id;
    document.getElementById('e-pid').value   = p.product_id;
    document.getElementById('e-cat').value   = p.category;
    document.getElementById('e-name').value  = p.name;
    document.getElementById('e-pxxs').value  = p.price_xxs||0;
    document.getElementById('e-pxs').value   = p.price_xs||0;
    document.getElementById('e-pstd').value  = p.price_standard||0;
    document.getElementById('e-sizes').value = (p.sizes||'').replace(/[{}"]/g,'');
    document.getElementById('e-colors').value= p.colors||'';
    document.getElementById('e-wa').value    = p.whatsapp_link||'https://wa.me/918655171445';
    for (let i=1;i<=10;i++) {
        const el = document.getElementById(`e-img${i}`);
        if (el) el.value = (p[`image_${i}`]&&p[`image_${i}`]!=='NULL') ? p[`image_${i}`] : '';
    }
    const imgs = getImages(p);
    document.getElementById('e-preview').innerHTML = imgs.map(u=>`<img src="${u}" onerror="this.style.display='none'">`).join('');
    document.getElementById('editModalBg').classList.add('open');
}

function closeEdit() { document.getElementById('editModalBg').classList.remove('open'); }

async function saveEdit() {
    const id = parseInt(document.getElementById('e-dbid').value);
    const updates = {
        category:       document.getElementById('e-cat').value.trim(),
        name:           document.getElementById('e-name').value.trim(),
        price_xxs:      parseFloat(document.getElementById('e-pxxs').value)||0,
        price_xs:       parseFloat(document.getElementById('e-pxs').value)||0,
        price_standard: parseFloat(document.getElementById('e-pstd').value)||0,
        sizes:          document.getElementById('e-sizes').value.trim(),
        colors:         document.getElementById('e-colors').value.trim(),
        whatsapp_link:  document.getElementById('e-wa').value.trim(),
    };
    for (let i=1;i<=10;i++) {
        const v = document.getElementById(`e-img${i}`)?.value.trim()||'';
        updates[`image_${i}`] = v||null;
    }
    const { error } = await sb.from('products').update(updates).eq('id',id);
    if (error) { showToast('Error: '+error.message, true); return; }
    showToast('✓ Product updated!');
    closeEdit();
    loadAdminData();
    loadProducts();
}

async function deleteProduct(id, name) {
    if (!confirm(`Delete "${name}"?\nThis cannot be undone.`)) return;
    const { error } = await sb.from('products').delete().eq('id',id);
    if (error) { showToast('Error: '+error.message, true); return; }
    showToast('Product deleted.');
    loadAdminData();
    loadProducts();
}

async function addProduct() {
    const pid  = document.getElementById('a-pid').value.trim();
    const name = document.getElementById('a-name').value.trim();
    if (!pid||!name) { showToast('Product ID and Name are required!', true); return; }

    const newProd = {
        product_id:     pid,
        category:       document.getElementById('a-cat').value.trim()||'Women',
        name,
        price_xxs:      parseFloat(document.getElementById('a-pxxs').value)||0,
        price_xs:       parseFloat(document.getElementById('a-pxs').value)||0,
        price_standard: parseFloat(document.getElementById('a-pstd').value)||0,
        sizes:          document.getElementById('a-sizes').value.trim(),
        colors:         document.getElementById('a-colors').value.trim(),
        whatsapp_link:  document.getElementById('a-wa').value.trim()||'https://wa.me/918655171445',
    };

    for (let i = 1; i <= 10; i++) {
        const input = document.getElementById(`a-img${i}`);
        newProd[`image_${i}`] = input ? input.value.trim() || null : null;
    }

    const { error } = await sb.from('products').insert([newProd]);
    if (error) { showToast('Error: '+error.message, true); return; }
    showToast('✓ Product added!');
    
    // Reset all 10 image fields + other fields
    const resetFields = ['a-pid','a-name','a-pxxs','a-pxs','a-pstd','a-sizes','a-colors'];
    for(let i=1; i<=10; i++) resetFields.push(`a-img${i}`);
    resetFields.forEach(id => { if(document.getElementById(id)) document.getElementById(id).value=''; });
    
    loadAdminData();
    loadProducts();
    showAPage('products');
}

function showToast(msg, isErr=false) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = `toast show ${isErr?'err':''}`;
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(()=>t.classList.remove('show'), 3200);
}

function openPolicy()  { document.getElementById('policyOverlay').classList.add('open'); }
function closePolicy() { document.getElementById('policyOverlay').classList.remove('open'); }
function closePolicyOutside(e) { if (e.target === document.getElementById('policyOverlay')) closePolicy(); }

initAuth();
loadProducts();
</script>
</body>
</html>
